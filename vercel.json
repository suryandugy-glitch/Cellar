{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node deploy/build-vercel.mjs",
  "outputDirectory": "build/vercel",
  "functions": {
    "api/site-assistant.mjs": {
      "includeFiles": "build/vercel/assistant-index.json",
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "cellar-studio-hq.vercel.app" }],
      "destination": "https://cellar-csv.vercel.app/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self' https:; base-uri 'none'; frame-ancestors 'none'; form-action 'self' https://formsubmit.co"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
